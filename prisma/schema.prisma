generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  isEmailVerified Boolean   @default(false)
  avatar          String?
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  height          Float?
  weight          Float?
  birthday        DateTime  @default(now()) @db.Timestamp(6)
  sex             Boolean   @default(true)
  devices         Device[]
  fridges         Fridge[]
  mealLogs        MealLog[]
  tokens          Token[]
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ingredients Ingredient[]
}

model Ingredient {
  id              Int                         @id @default(autoincrement())
  name            String
  categoryId      Int?
  desciption      String?
  protein         Float?
  unit            String                      @default("gam")
  carbs           Float?
  fat             Float?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  dishIngredients DishIngredient[]
  fridgeItems     FridgeItem[]
  category        Category?                   @relation(fields: [categoryId], references: [id])
  snapshots       MealLogIngredientSnapshot[]
}

model Dish {
  id           Int                 @id @default(autoincrement())
  name         String
  prepTimeMin  Int?
  cookTimeMin  Int?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  difficulty   Difficulty
  description  String?
  instructions Json?
  images       String[]            @default([])
  calories     Float?
  ingredients  DishIngredient[]
  transactions FridgeTransaction[]
  mealLogs     MealLog[]
}

model DishIngredient {
  id              Int        @id @default(autoincrement())
  dishId          Int
  ingredientId    Int
  amount          Float
  unit            String     @default("gam")
  gramsEquivalent Float
  dish            Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([dishId])
  @@index([ingredientId])
}

model MealLog {
  id           Int                         @id @default(autoincrement())
  userId       Int
  eatenAt      DateTime
  mealType     String?
  note         String?
  dishId       Int?
  totalKcal    Float?
  totalProtein Float?
  totalCarbs   Float?
  totalFat     Float?
  createdAt    DateTime                    @default(now())
  dish         Dish?                       @relation(fields: [dishId], references: [id])
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots    MealLogIngredientSnapshot[]

  @@index([userId])
  @@index([dishId])
  @@index([eatenAt])
}

model MealLogIngredientSnapshot {
  id              Int         @id @default(autoincrement())
  mealLogId       Int
  ingredientId    Int?
  ingredientName  String
  amount          Float
  unit            String
  gramsEquivalent Float
  kcal            Float?
  protein         Float?
  carbs           Float?
  fat             Float?
  createdAt       DateTime    @default(now())
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id])
  mealLog         MealLog     @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
}

model Fridge {
  id           Int                 @id @default(autoincrement())
  userId       Int
  name         String              @default("My Fridge")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        FridgeItem[]
  transactions FridgeTransaction[]

  @@index([userId])
}

model FridgeItem {
  id           Int        @id @default(autoincrement())
  fridgeId     Int
  ingredientId Int
  priority     Priority
  quantity     Float      @default(0)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  fridge       Fridge     @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([fridgeId, ingredientId])
  @@index([fridgeId])
  @@index([ingredientId])
}

model FridgeTransaction {
  id            Int                   @id @default(autoincrement())
  fridgeId      Int
  type          FridgeTransactionType
  note          String?
  relatedDishId Int?
  createdAt     DateTime              @default(now())
  fridge        Fridge                @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  relatedDish   Dish?                 @relation(fields: [relatedDishId], references: [id])

  @@index([fridgeId])
  @@index([relatedDishId])
}

model Device {
  id         Int      @id @default(autoincrement())
  ownerId    Int?
  deviceUid  String   @unique
  apiKeyHash String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  userId      Int
  type        TokenType
  expires     DateTime
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum FridgeTransactionType {
  PURCHASE
  COOK
  ADJUST
  DISCARD
  EXPIRE
  IMPORT
}
