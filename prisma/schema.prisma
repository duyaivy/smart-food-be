generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  password        String
  isEmailVerified Boolean          @default(false)
  avatar          String?
  role            Role             @default(USER)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  height          Float?
  weight          Float?
  birthday        DateTime         @default(now()) @db.Timestamp(6)
  sex             Boolean          @default(true)
  activityLevel   ActivityLevel    @default(SEDENTARY)
  devices         Device[]
  fridges         Fridge?
  mealLogs        MealLog[]
  pushTokens      PushToken[]
  recommendations Recommendation[]
  tokens          Token[]
}

model Category {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  isDeleted   Boolean      @default(false)
  ingredients Ingredient[]
}

model Ingredient {
  id              Int                         @id @default(autoincrement())
  name            String
  categoryId      Int?
  protein         Float?
  carb            Float?
  fat             Float?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  unit            Unit                        @default(GAM)
  images          String[]
  description     String?
  isDeleted       Boolean                     @default(false)
  dishIngredients DishIngredient[]
  fridgeItems     FridgeItem[]
  category        Category?                   @relation(fields: [categoryId], references: [id])
  snapshots       MealLogIngredientSnapshot[]
}

model Dish {
  id           Int              @id @default(autoincrement())
  name         String
  prepTimeMin  Int?
  cookTimeMin  Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  difficulty   Difficulty
  description  String?
  instructions Json?
  images       String[]
  calories     Float?
  isDeleted    Boolean          @default(false)
  type         DishType         @default(MAIN_DISH)
  ingredients  DishIngredient[]
  mealLogs     MealLog[]
}

model DishIngredient {
  id              Int        @id @default(autoincrement())
  dishId          Int
  ingredientId    Int
  amount          Float
  gramsEquivalent Float
  unit            Unit       @default(GAM)
  dish            Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([dishId])
  @@index([ingredientId])
}

model MealLog {
  id           Int                         @id @default(autoincrement())
  userId       Int
  eatenAt      DateTime                    @default(now())
  note         String?
  dishId       Int?
  customName   String?
  isCustom     Boolean                     @default(false)
  tag          String?
  totalKcal    Float?
  totalProtein Float?
  totalFat     Float?
  totalCarb    Float?
  mealType     MealType?
  createdAt    DateTime                    @default(now())

  dish         Dish?                       @relation(fields: [dishId], references: [id])
  user         User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots    MealLogIngredientSnapshot[]

  @@index([userId])
  @@index([dishId])
  @@index([createdAt])
  @@index([eatenAt])
}

model MealLogIngredientSnapshot {
  id              Int         @id @default(autoincrement())
  mealLogId       Int
  ingredientId    Int?
  ingredientName  String
  amount          Float
  unit            String
  gramsEquivalent Float
  kcal            Float?
  protein         Float?
  fat             Float?
  createdAt       DateTime    @default(now())
  carb            Float?
  ingredient      Ingredient? @relation(fields: [ingredientId], references: [id])
  mealLog         MealLog     @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  @@index([mealLogId])
}

model Fridge {
  id           Int                 @id @default(autoincrement())
  userId       Int                 @unique
  name         String              @default("My Fridge")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        FridgeItem[]
  transactions FridgeTransaction[]
}

model FridgeItem {
  id           Int        @id @default(autoincrement())
  fridgeId     Int
  ingredientId Int
  priority     Priority
  quantity     Float      @default(0)
  updatedAt    DateTime   @updatedAt
  createdAt    DateTime   @default(now())
  deleteAt     DateTime?
  dueDate      DateTime
  fridge       Fridge     @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([fridgeId])
  @@index([ingredientId])
  @@index([dueDate])
  @@index([deleteAt])
}

model FridgeTransaction {
  id        Int                   @id @default(autoincrement())
  fridgeId  Int
  type      FridgeTransactionType
  note      String?
  createdAt DateTime              @default(now())
  fridge    Fridge                @relation(fields: [fridgeId], references: [id], onDelete: Cascade)

  @@index([fridgeId])
}

model Device {
  id         Int      @id @default(autoincrement())
  ownerId    Int?
  deviceUid  String   @unique
  apiKeyHash String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  owner      User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model PushToken {
  id               Int                   @id @default(autoincrement())
  deviceName       String
  token            String
  createdAt        DateTime              @default(now())
  userId           Int
  notificationLogs PushNotificationLog[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PushNotificationLog {
  id             Int                       @id @default(autoincrement())
  pushTokenId    Int
  title          String?
  body           String?
  data           Json?
  expoTicketId   String?                   @unique
  ticketStatus   String?
  receiptStatus  String?
  receiptDetails Json?
  status         PushNotificationLogStatus @default(PENDING)
  sentAt         DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  pushToken      PushToken                 @relation(fields: [pushTokenId], references: [id], onDelete: Cascade)

  @@index([pushTokenId])
  @@index([expoTicketId])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  userId      Int
  type        TokenType
  expires     DateTime
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Recommendation {
  id        Int                  @id @default(autoincrement())
  status    RecommendationStatus
  userId    Int
  input     Json
  output    Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  message   String?
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum FridgeTransactionType {
  COOK
  ADJUST
  DISCARD
  EXPIRE
  ADD
}

enum DishType {
  MAIN_DISH
  VEGETABLE
  SOUP
}

enum ActivityLevel {
  SEDENTARY
  LIGHT
  MODERATE
  ACTIVE
  VERY_ACTIVE
}

enum Unit {
  GAM
  NUMBER
  SPOON
}

enum PushNotificationLogStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

enum RecommendationStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  FAILURE
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
}
