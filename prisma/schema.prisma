generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model User {
  id              Int      @id @default(autoincrement())
  name            String
  email           String   @unique
  password        String
  isEmailVerified Boolean  @default(false)
  avatar          String?
  role            Role     @default(USER)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  height Float?
  weight Float?
  age    Int?

  mealLogs   MealLog[]
  fridges    Fridge[]
  devices    Device[]
  tokens     Token[]
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients Ingredient[]
}

model Ingredient {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int?
  desciption String?
  protein    Float?
  unit       String   @default("gam")
  carbs      Float?
  fat        Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  snapshots       MealLogIngredientSnapshot[]
  dishIngredients DishIngredient[]
  fridgeItems     FridgeItem[]
}

model Dish {
  id           Int      @id @default(autoincrement())
  name         String
  instructions String?
  images       String?
  prepTimeMin  Int?
  cookTimeMin  Int?
  difficulty   String? // Easy/Medium/Hard
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ingredients  DishIngredient[]
  mealLogs     MealLog[]
  transactions FridgeTransaction[]
}

model DishIngredient {
  id              Int    @id @default(autoincrement())
  dishId          Int
  ingredientId    Int
  amount          Float
  unit            String @default("g")
  gramsEquivalent Float

  dish       Dish       @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@index([dishId])
  @@index([ingredientId])
}

model MealLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  eatenAt  DateTime
  mealType String? // breakfast/lunch/dinner/snack
  note     String?
  dishId   Int? // nullable

  totalKcal    Float?
  totalProtein Float?
  totalCarbs   Float?
  totalFat     Float?

  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  dish Dish? @relation(fields: [dishId], references: [id], onDelete: SetNull)

  snapshots MealLogIngredientSnapshot[]

  @@index([userId])
  @@index([dishId])
  @@index([eatenAt])
}

model MealLogIngredientSnapshot {
  id              Int    @id @default(autoincrement())
  mealLogId       Int
  ingredientId    Int? // nullable
  ingredientName  String
  amount          Float
  unit            String
  gramsEquivalent Float

  kcal    Float?
  protein Float?
  carbs   Float?
  fat     Float?

  createdAt DateTime @default(now())

  mealLog    MealLog     @relation(fields: [mealLogId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([mealLogId])
}

model Fridge {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @default("My Fridge")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  items        FridgeItem[]
  transactions FridgeTransaction[]

  @@index([userId])
}

model FridgeItem {
  id           Int      @id @default(autoincrement())
  fridgeId     Int
  ingredientId Int
  priority     Priority
  quantity     Float    @default(0)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  fridge     Fridge     @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([fridgeId, ingredientId])
  @@index([fridgeId])
  @@index([ingredientId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model FridgeTransaction {
  id            Int                   @id @default(autoincrement())
  fridgeId      Int
  type          FridgeTransactionType
  note          String?
  relatedDishId Int?
  createdAt     DateTime              @default(now())

  fridge      Fridge @relation(fields: [fridgeId], references: [id], onDelete: Cascade)
  relatedDish Dish?  @relation(fields: [relatedDishId], references: [id], onDelete: SetNull)

  @@index([fridgeId])
  @@index([relatedDishId])
}

enum FridgeTransactionType {
  PURCHASE
  COOK
  ADJUST
  DISCARD
  EXPIRE
  IMPORT
}

model Device {
  id         Int      @id @default(autoincrement())
  ownerId    Int?
  deviceUid  String   @unique
  apiKeyHash String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  owner User? @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Token {
  id          Int       @id @default(autoincrement())
  token       String    @unique
  userId      Int
  type        TokenType
  expires     DateTime
  blacklisted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}
